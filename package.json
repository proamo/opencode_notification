{
  "name": "opencode-telegram-link",
  "version": "1.0.0-rc.5",
  "description": "Privacy-first Telegram notifications and remote replies for OpenCode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proamo/opencode_notification.git"
  },
  "homepage": "https://github.com/proamo/opencode_notification#readme",
  "bugs": {
    "url": "https://github.com/proamo/opencode_notification/issues"
  },
  "type": "module",
  "main": "./dist/plugin.js",
  "module": "./dist/plugin.js",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "bin": {
    "opencode-telegram-broker": "./dist/broker/main.js"
  },
  "files": [
    "dist",
    "container",
    "docker-compose.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/plugin.ts src/protocol/index.ts src/broker/main.ts --outdir dist --target bun --format esm --sourcemap=external",
    "build:types": "tsc --project tsconfig.build.json",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "license:check": "bun scripts/release-smoke.ts --license-only",
    "prepack": "bun run build",
    "release:changelog": "bun scripts/generate-changelog.ts",
    "release:check": "bun run check && bun test && bun run license:check && bun run release:smoke && npm pack --dry-run",
    "release:smoke": "bun scripts/release-smoke.ts",
    "setup": "bun src/broker/main.ts setup",
    "init": "bun src/broker/main.ts setup",
    "uninstall": "bun src/broker/main.ts uninstall",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0 <2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@opencode-ai/plugin": "^1.18.18",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
