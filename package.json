{
  "name": "opencode-telegram-link",
  "version": "0.0.0",
  "description": "Privacy-first Telegram notifications and remote replies for OpenCode",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "bin": {
    "opencode-telegram-broker": "./dist/broker/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/plugin.ts src/protocol/index.ts src/broker/main.ts --outdir dist --target bun --format esm --sourcemap=external",
    "build:types": "tsc --project tsconfig.build.json",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0 <2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@opencode-ai/plugin": "^1.18.18",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
